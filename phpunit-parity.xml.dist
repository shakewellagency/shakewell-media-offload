<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap-parity.php"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
	beStrictAboutOutputDuringTests="true"
>
	<testsuites>
		<testsuite name="parity">
			<directory suffix="Test.php">tests/Parity</directory>
		</testsuite>
	</testsuites>
</phpunit>
